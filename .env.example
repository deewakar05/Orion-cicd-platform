# Environment variables for Docker Compose local development
# Copy this file to .env and fill in production values — NEVER commit .env!

# ─── Node.js Service ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1h
LOG_LEVEL=debug

# ─── Java Service ─────────────────────────────────────────────────────────────
APP_ENV=development
SPRING_PROFILES_ACTIVE=default
JPA_DDL_AUTO=update

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_DB=devopsdb
POSTGRES_USER=devops_admin
POSTGRES_PASSWORD=changeme_in_production

# ─── Docker ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=devops-platform
